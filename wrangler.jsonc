{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cauchye-com",
	"account_id": "89d1d38c83b2dbcc52f5df0f165a05ab",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		// EmDash administration (/_emdash/admin and its first-admin setup API) is closed.
		// Set to "true" only while staff need the admin.
		"EMDASH_ADMIN_ENABLED": "false"
	},
	// Dedicated resources in the CAUCHYE ASIA account (created 2026-10-13).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cauchye-com",
			"database_id": "3d0c054a-8788-44d8-bce6-1de1bd288a06"
		}
	],
	"kv_namespaces": [
		{
			// Astro sessions, used only by the EmDash admin sign-in.
			"binding": "SESSION",
			// KV namespace: cauchye-com-session
			"id": "d91506517da340fcbc5528d82988f4a1"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "cauchye-com-media"
		}
	],
	// EmDash maintenance: scheduled publishing and housekeeping.
	"triggers": {
		"crons": ["* * * * *"]
	}
}
