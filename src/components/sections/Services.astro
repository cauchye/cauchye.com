---
import {
	ArrowRight,
	Bot,
	BrainCircuit,
	ChartNoAxesCombined,
	Landmark,
	Sparkles
} from 'lucide-astro';

import { Badge } from '../ui/badge/index.js';
import { Button } from '../ui/button/index.js';
import type { Dictionary, Locale } from '../../i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
	locale: Locale;
	messages: Dictionary;
}

const { locale, messages: m } = Astro.props;
const businesses = [
	{
		icon: BrainCircuit,
		title: m.business_ai_title,
		lead: m.business_ai_lead,
		body: m.business_ai_body,
		points: [
			m.business_ai_point_1,
			m.business_ai_point_2,
			m.business_ai_point_3,
			m.business_ai_point_4
		],
		href: `/${locale}/business/it-ai`,
		cta: m.business_ai_cta,
		accent: true
	},
	{
		icon: Landmark,
		title: m.business_advisory_title,
		lead: m.business_advisory_lead,
		body: m.business_advisory_body,
		points: [
			m.business_advisory_point_1,
			m.business_advisory_point_2,
			m.business_advisory_point_3,
			m.business_advisory_point_4
		],
		href: `/${locale}/business/corporate-advisory`,
		cta: m.business_advisory_cta,
		accent: false
	}
];
---

<section id="services" class="border-t border-border section">
	<SectionHeading eyebrow={m.services_eyebrow} title={m.services_title} />
	<div class="mt-14 grid gap-5 lg:grid-cols-2">
		{
			businesses.map((business) => {
				const Icon = business.icon;
				return (
					<article
						class:list={[
							'group relative isolate flex min-h-[34rem] flex-col overflow-hidden rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl md:p-9',
							business.accent
								? 'border-brand/25 bg-brand text-brand-foreground shadow-lg shadow-brand/10'
								: 'border-border bg-card text-card-foreground hover:border-brand/30'
						]}
					>
						{business.accent && (
							<div
								class="pointer-events-none absolute inset-0 -z-10 grid-backdrop opacity-30"
								aria-hidden="true"
							/>
						)}
						<div class="flex items-center">
							<span
								class:list={[
									'flex size-12 items-center justify-center rounded-xl',
									business.accent ? 'bg-white/12 text-white' : 'bg-brand-subtle text-brand'
								]}
							>
								<Icon class="size-6" />
							</span>
						</div>

						<h3 class="mt-9 text-3xl leading-tight font-semibold md:text-[2.1rem]">
							{business.title}
						</h3>
						<p
							class:list={[
								'mt-4 text-lg font-medium',
								business.accent ? 'text-white' : 'text-foreground'
							]}
						>
							{business.lead}
						</p>
						<p
							class:list={[
								'mt-4 leading-relaxed',
								business.accent ? 'text-white/72' : 'text-muted-foreground'
							]}
						>
							{business.body}
						</p>

						<div class="mt-8 flex flex-wrap gap-2">
							{business.points.map((point) => (
								<Badge
									variant="outline"
									class:list={[
										'h-auto rounded-full px-3 py-1.5 text-xs',
										business.accent && 'border-white/20 bg-white/8 text-white'
									]}
								>
									{point}
								</Badge>
							))}
						</div>

						<div class="mt-auto pt-10">
							<Button
								href={business.href}
								variant={business.accent ? 'secondary' : 'brand'}
								size="lg"
								class="h-11 px-5"
							>
								{business.cta}
								<ArrowRight data-icon="inline-end" />
							</Button>
						</div>

						<div
							class="pointer-events-none absolute right-8 bottom-8 -z-10 opacity-[0.07]"
							aria-hidden="true"
						>
							{business.accent ? <Bot class="size-40" /> : <ChartNoAxesCombined class="size-40" />}
							<Sparkles class="absolute -top-4 -left-6 size-8" />
						</div>
					</article>
				);
			})
		}
	</div>
</section>
