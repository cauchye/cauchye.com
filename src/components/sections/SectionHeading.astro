---
interface Props {
	eyebrow: string;
	title: string;
	subtitle?: string;
	body?: string;
}

const { eyebrow, title, subtitle, body } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-[1fr_1.4fr] md:gap-16">
	<div>
		<p class="font-mono text-[0.6875rem] tracking-[0.14em] text-brand uppercase">{eyebrow}</p>
		<h2 class="mt-3 text-3xl font-semibold md:text-4xl">{title}</h2>
		{subtitle && <p class="mt-2 text-base text-muted-foreground">{subtitle}</p>}
	</div>
	{body && <p class="leading-relaxed text-muted-foreground md:mt-1">{body}</p>}
</div>
