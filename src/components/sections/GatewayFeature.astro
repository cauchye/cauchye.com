---
import { ArrowUpRight, BanknoteArrowDown, Check, ReceiptText, TrendingDown } from 'lucide-astro';

import type { Dictionary } from '../../i18n';
import { d6e } from '../../site';
import { Button } from '../ui/button/index.js';
import D6eMark from '../D6eMark.astro';

interface Props {
	messages: Dictionary;
}

const { messages: m } = Astro.props;
const points = [
	{ icon: TrendingDown, text: m.gateway_point_1 },
	{ icon: ReceiptText, text: m.gateway_point_2 },
	{ icon: BanknoteArrowDown, text: m.gateway_point_3 }
];
const providers = [
	{ name: 'OpenAI', logo: '/brands/openai.svg' },
	{ name: 'Anthropic', logo: '/brands/anthropic.svg' },
	{ name: 'Google Gemini', logo: '/brands/gemini.svg' },
	{ name: 'xAI Grok', logo: '/brands/grok.svg' }
];
---

<section id="product" class="border-t border-border py-14 md:py-18">
	<h2 class="text-3xl font-semibold md:text-4xl">{m.gateway_eyebrow}</h2>
	<div
		class="dark relative isolate mt-10 overflow-hidden rounded-3xl bg-background px-6 py-12 text-foreground shadow-2xl md:px-12 md:py-16"
	>
		<div
			class="pointer-events-none absolute inset-0 -z-10 grid-backdrop opacity-25"
			aria-hidden="true"
		>
		</div>
		<div
			class="pointer-events-none absolute -top-32 -right-20 -z-10 size-96 rounded-full bg-brand/30 blur-3xl"
			aria-hidden="true"
		>
		</div>
		<div class="flex items-center gap-3">
			<span class="flex size-10 items-center justify-center rounded-xl bg-white/10 text-white">
				<D6eMark class="size-7" />
			</span>
			<p class="text-sm font-semibold tracking-wide text-white">d6e AI Gateway</p>
		</div>
		<h3 class="mt-7 text-3xl leading-tight font-semibold md:text-5xl">
			{m.gateway_title}
		</h3>
		<div class="mt-10 grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:items-end">
			<div>
				<p class="leading-relaxed text-muted-foreground md:text-lg">
					{m.gateway_body}
				</p>
				<ul class="mt-8 grid gap-3 sm:grid-cols-3">
					{
						points.map(({ icon: Icon, text }) => (
							<li class="rounded-xl border border-white/10 bg-white/5 p-4">
								<Icon class="size-5 text-brand" />
								<span class="mt-3 block text-sm leading-relaxed text-white/75">{text}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur-sm md:p-6">
				<p class="text-xs font-medium tracking-[0.14em] text-white/50 uppercase">
					{m.gateway_providers_label}
				</p>
				<div class="mt-5 flex flex-wrap gap-2">
					{
						providers.map((provider) => (
							<div class="flex size-11 items-center justify-center rounded-full bg-white text-[#191919]">
								<img
									src={provider.logo}
									alt={provider.name}
									class="size-5 object-contain"
									width="20"
									height="20"
									loading="lazy"
								/>
							</div>
						))
					}
				</div>
				<div class="mt-5 flex items-center gap-2 text-xs text-white/50">
					<Check class="size-4 text-brand" />
					{m.gateway_api_label}
				</div>
				<Button
					href={d6e.gatewayUrl}
					target="_blank"
					rel="noreferrer"
					variant="brand"
					size="lg"
					class="mt-6 h-11 w-full"
				>
					{m.gateway_cta}
					<ArrowUpRight data-icon="inline-end" />
				</Button>
			</div>
		</div>
	</div>
</section>
