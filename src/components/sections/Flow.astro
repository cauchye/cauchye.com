---
import type { Dictionary } from '../../i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
	messages: Dictionary;
}

const { messages: m } = Astro.props;
const steps = [
	{ title: m.lp_step_1_title, body: m.lp_step_1_body },
	{ title: m.lp_step_2_title, body: m.lp_step_2_body },
	{ title: m.lp_step_3_title, body: m.lp_step_3_body }
];
---

<section id="flow" class="border-t border-border section">
	<div data-reveal>
		<SectionHeading eyebrow={m.flow_eyebrow} title={m.flow_title} />
	</div>
	<ol class="relative mt-12 grid gap-6 md:grid-cols-3">
		<div
			class="pointer-events-none absolute top-10 right-8 left-8 hidden h-px bg-linear-to-r from-brand/0 via-brand/60 to-brand/0 md:block"
			aria-hidden="true"
		>
		</div>
		{
			steps.map((step, index) => (
				<li
					class="relative rounded-3xl border border-border bg-background p-7 shadow-sm transition-transform duration-300 hover:-translate-y-1"
					data-reveal
					style={`--reveal-index: ${index}`}
				>
					<span class="flex size-12 items-center justify-center rounded-full bg-brand font-mono text-sm font-semibold text-brand-foreground">
						0{index + 1}
					</span>
					<p class="mt-6 text-xl font-semibold">{step.title}</p>
					<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
				</li>
			))
		}
	</ol>
</section>
