---
import { ArrowRight, CalendarDays, Check } from 'lucide-astro';

import type { Dictionary, Locale } from '../../i18n';
import { consultHref } from '../../site';
import MapBackdrop from '../MapBackdrop.astro';
import { Button } from '../ui/button/index.js';

interface Props {
	locale: Locale;
	messages: Dictionary;
}

const { locale, messages: m } = Astro.props;
const points = [m.hero_point_1, m.hero_point_2, m.hero_point_3];
---

<section class="relative isolate pt-16 pb-16 md:pt-24 md:pb-24">
	<div
		class="pointer-events-none absolute inset-0 -z-10 -mx-5 grid-backdrop md:-mx-8"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute -top-10 -left-24 -z-10 size-96 rounded-full bg-brand/20 blur-3xl"
		data-glow
		aria-hidden="true"
	>
	</div>
	<MapBackdrop
		class="pointer-events-none absolute right-0 bottom-4 -z-10 hidden h-60 w-72 text-brand/12 lg:block"
	/>
	<div class="grid items-end gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
		<div>
			<h1
				class="text-5xl leading-[1.08] font-semibold sm:text-6xl md:text-7xl lg:text-[5.25rem]"
				data-hero-rise
			>
				<span class="block">{m.hero_title_lead}</span>
				<span class="block bg-linear-to-br from-brand to-foreground bg-clip-text text-transparent">
					{m.hero_title_accent}
				</span>
			</h1>
			<p
				class="mt-8 max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg"
				data-hero-rise
				style="--rise-index: 1"
			>
				{m.hero_body}
			</p>
			<div
				class="mt-10 flex flex-wrap items-center gap-3"
				data-hero-cta
				data-hero-rise
				style="--rise-index: 2"
			>
				<Button
					href={consultHref(locale)}
					variant="brand"
					size="lg"
					class="h-13 px-7 text-base shadow-lg shadow-brand/25"
					data-cta="hero-consult"
				>
					<CalendarDays data-icon="inline-start" />
					{m.cta_consult}
					<ArrowRight data-icon="inline-end" />
				</Button>
				<Button
					href="#official-media"
					variant="outline"
					size="lg"
					class="h-13 px-7 text-base"
					data-cta="hero-media"
				>
					{m.cta_media}
				</Button>
			</div>
			<p class="mt-4 text-xs text-muted-foreground" data-hero-rise style="--rise-index: 3">
				{m.hero_cta_note}
			</p>
		</div>
		<ul
			class="flex flex-col gap-3 rounded-3xl border border-border bg-background/80 p-6 shadow-xl backdrop-blur md:p-8"
			data-hero-points
			data-hero-rise
			style="--rise-index: 2"
		>
			{
				points.map((point, index) => (
					<li class="flex items-start gap-3 border-b border-border pb-3 last:border-b-0 last:pb-0">
						<span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-brand/15 font-mono text-xs text-brand">
							{index + 1}
						</span>
						<span class="text-sm leading-relaxed md:text-base">{point}</span>
						<Check class="ml-auto size-4 shrink-0 text-brand" aria-hidden="true" />
					</li>
				))
			}
		</ul>
	</div>
</section>
