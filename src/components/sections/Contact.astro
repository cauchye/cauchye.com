---
import { Check, Send } from 'lucide-astro';

import InquiryTypeSelect from '../InquiryTypeSelect.svelte';
import { Button } from '../ui/button/index.js';
import { Field, FieldDescription, FieldError, FieldGroup, FieldLabel } from '../ui/field/index.js';
import { Input } from '../ui/input/index.js';
import { Textarea } from '../ui/textarea/index.js';
import {
	ATTRIBUTION_FIELDS,
	BOOKING_SLOTS,
	BOOKING_TIMES,
	MEETING_TOOLS,
	bookingWindow
} from '../../contact';
import type { Dictionary, Locale } from '../../i18n';

interface Props {
	locale: Locale;
	messages: Dictionary;
	state?: 'success' | 'error';
	// `book`: the meeting request page, where the first preferred slot is required.
	mode?: 'contact' | 'book';
}

const { locale, messages: m, state, mode = 'contact' } = Astro.props;
const isBooking = mode === 'book';
const slotWindow = bookingWindow();
const toolLabels: Record<(typeof MEETING_TOOLS)[number], string> = {
	'google-meet': 'Google Meet',
	zoom: 'Zoom',
	teams: 'Microsoft Teams',
	any: m.booking_tool_any
};
const title = isBooking ? m.booking_title : m.contact_title;
const body = isBooking ? m.booking_body : m.contact_body;
const inquiryTypes = [
	{ value: 'it-ai', label: m.form_inquiry_it_ai },
	{ value: 'corporate-advisory', label: m.form_inquiry_advisory },
	{ value: 'company', label: m.form_inquiry_company },
	{ value: 'sales', label: m.form_inquiry_sales }
];
---

<section id="contact" class="section">
	<div
		class="dark relative overflow-hidden rounded-2xl bg-background px-6 py-14 text-foreground md:px-12 md:py-20"
	>
		<div
			class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-brand/25 blur-3xl"
			aria-hidden="true"
		>
		</div>
		<div class="relative grid gap-10 md:grid-cols-[1fr_1.2fr] md:gap-16">
			<div>
				<p class="font-mono text-[0.6875rem] tracking-[0.14em] text-brand uppercase">
					{m.contact_eyebrow}
				</p>
				<h1 class="mt-3 text-3xl font-semibold md:text-4xl">{title}</h1>
				<p class="mt-4 leading-relaxed text-muted-foreground">{body}</p>
				<p class="mt-6 rounded-xl bg-muted/60 p-4 text-sm leading-relaxed" data-reply-time>
					{m.form_reply_time}
				</p>
			</div>

			<div
				data-contact-success
				class:list={[
					'items-start gap-3 self-center rounded-xl bg-muted/60 p-6',
					state === 'success' ? 'flex' : 'hidden'
				]}
				role="status"
				tabindex="-1"
			>
				<span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-brand">
					<Check class="size-4 text-brand-foreground" />
				</span>
				<div>
					<p class="font-medium">{m.form_success_title}</p>
					<p class="mt-1 text-sm text-muted-foreground">
						{isBooking ? m.booking_success_body : m.form_success_body}
					</p>
				</div>
			</div>

			<form
				data-contact-form
				method="POST"
				action={`/api/contact?locale=${locale}`}
				novalidate
				class:list={['flex flex-col gap-5', state === 'success' && 'hidden']}
				data-submit-label={isBooking ? m.booking_submit : m.form_submit}
				data-submitting-label={m.form_submitting}
				data-unavailable-message={m.form_error_unavailable}
				data-weekend-message={m.booking_error_weekend}
			>
				<input type="hidden" name="locale" value={locale} />
				<input type="hidden" name="mode" value={mode} />
				{
					ATTRIBUTION_FIELDS.map((field) => (
						<input type="hidden" name={field} value="" data-attribution={field} />
					))
				}
				<div class="hidden" aria-hidden="true">
					<label for="website">Website</label>
					<input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<FieldGroup class="gap-5">
					<Field>
						<FieldLabel for="inquiryType">{m.form_label_inquiry_type}</FieldLabel>
						<InquiryTypeSelect
							name="inquiryType"
							placeholder={m.form_inquiry_placeholder}
							options={inquiryTypes}
							errorId="inquiryType-error"
							client:load
						/>
						<FieldError id="inquiryType-error" data-error-for="inquiryType" class="hidden">
							<span></span>
						</FieldError>
					</Field>

					<div class="grid gap-5 sm:grid-cols-2">
						<Field>
							<FieldLabel for="name">{m.form_label_name}</FieldLabel>
							<Input
								id="name"
								name="name"
								required
								maxlength={100}
								autocomplete="name"
								aria-describedby="name-error"
								class="h-10 px-3 py-2"
							/>
							<FieldError id="name-error" data-error-for="name" class="hidden">
								<span></span>
							</FieldError>
						</Field>

						<Field>
							<FieldLabel for="company">
								{m.form_label_company}
								<span class="font-normal text-muted-foreground">
									{m.form_label_company_optional}
								</span>
							</FieldLabel>
							<Input
								id="company"
								name="company"
								maxlength={100}
								autocomplete="organization"
								aria-describedby="company-error"
								class="h-10 px-3 py-2"
							/>
							<FieldError id="company-error" data-error-for="company" class="hidden">
								<span></span>
							</FieldError>
						</Field>
					</div>

					<Field>
						<FieldLabel for="email">{m.form_label_email}</FieldLabel>
						<Input
							id="email"
							name="email"
							type="email"
							required
							maxlength={200}
							autocomplete="email"
							aria-describedby="email-error"
							class="h-10 px-3 py-2"
						/>
						<FieldError id="email-error" data-error-for="email" class="hidden">
							<span></span>
						</FieldError>
					</Field>

					{
						isBooking && (
							<fieldset
								class="flex flex-col gap-4 rounded-xl border border-border p-4"
								data-booking
							>
								<legend class="px-1 text-sm font-medium">{m.booking_slots_label}</legend>
								<p class="text-xs leading-relaxed text-muted-foreground">{m.booking_slots_hint}</p>
								{BOOKING_SLOTS.map((slot, index) => (
									<div class="flex flex-col gap-1.5">
										<label class="text-sm" for={`${slot}_date`}>
											{m.booking_slot_label.replace('{n}', String(index + 1))}
											{index > 0 && (
												<span class="font-normal text-muted-foreground">
													{' '}
													{m.form_label_company_optional}
												</span>
											)}
										</label>
										<div class="grid grid-cols-[1fr_8rem] gap-2" data-field-control={slot}>
											<input
												type="date"
												id={`${slot}_date`}
												name={`${slot}_date`}
												min={slotWindow.min}
												max={slotWindow.max}
												data-booking-date
												aria-describedby={`${slot}-error`}
												class="h-10 rounded-3xl bg-input/50 px-3 text-base md:text-sm"
											/>
											<select
												name={`${slot}_time`}
												aria-label={m.booking_time_label}
												class="h-10 rounded-3xl bg-input/50 px-3 text-base md:text-sm"
											>
												<option value="">{m.booking_time_label}</option>
												{BOOKING_TIMES.map((time) => (
													<option value={time}>{time}</option>
												))}
											</select>
										</div>
										<FieldError id={`${slot}-error`} data-error-for={slot} class="hidden">
											<span />
										</FieldError>
									</div>
								))}
								<div class="flex flex-col gap-2" data-field-control="meetingTool">
									<p class="text-sm">{m.booking_tool_label}</p>
									<div class="flex flex-wrap gap-2">
										{MEETING_TOOLS.map((tool, index) => (
											<label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-border px-3 py-1.5 text-sm has-checked:border-brand has-checked:text-brand">
												<input
													type="radio"
													name="meetingTool"
													value={tool}
													checked={index === 0}
													class="accent-current"
												/>
												{toolLabels[tool]}
											</label>
										))}
									</div>
									<FieldError id="meetingTool-error" data-error-for="meetingTool" class="hidden">
										<span />
									</FieldError>
								</div>
							</fieldset>
						)
					}

					<Field>
						<FieldLabel for="message">
							{m.form_label_message}
							<span class="font-normal text-muted-foreground">
								{m.form_label_message_optional}
							</span>
						</FieldLabel>
						<Textarea
							id="message"
							name="message"
							maxlength={4000}
							rows={5}
							aria-describedby="message-hint message-error"
							class="min-h-28 resize-y px-3"
						/>
						<FieldDescription id="message-hint">{m.form_hint_message}</FieldDescription>
						<FieldError id="message-error" data-error-for="message" class="hidden">
							<span></span>
						</FieldError>
					</Field>
				</FieldGroup>

				<p
					data-form-error
					role="alert"
					class:list={[
						'rounded-lg bg-destructive/15 px-4 py-3 text-sm text-destructive',
						state === 'error' ? 'block' : 'hidden'
					]}
				>
					{m.form_error_unavailable}
				</p>

				<Button type="submit" variant="brand" class="h-12 gap-2 self-start px-8">
					<span data-submit-text>{isBooking ? m.booking_submit : m.form_submit}</span>
					<Send />
				</Button>
			</form>
		</div>
	</div>
</section>

<script>
	type ContactResponse = {
		success?: boolean;
		errors?: Record<string, string[]>;
		unavailable?: boolean;
	};

	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const success = document.querySelector<HTMLElement>('[data-contact-success]');

	// Weekends cannot be picked: clear the date and say so.
	document.querySelectorAll<HTMLInputElement>('[data-booking-date]').forEach((input) => {
		input.addEventListener('change', () => {
			if (!input.value) return;
			const weekday = new Date(`${input.value}T00:00:00Z`).getUTCDay();
			const error = document.querySelector<HTMLElement>(
				`[data-error-for="${input.id.replace('_date', '')}"]`
			);
			if (weekday === 0 || weekday === 6) {
				input.value = '';
				if (error) {
					error.textContent = form?.dataset.weekendMessage ?? '';
					error.classList.remove('hidden');
				}
			} else error?.classList.add('hidden');
		});
	});

	// Fill in where the visit came from (stored by the layout on the first page).
	try {
		const attribution = JSON.parse(sessionStorage.getItem('cauchye_attribution') ?? '{}') as Record<
			string,
			string
		>;
		attribution.cta = sessionStorage.getItem('cauchye_cta') ?? '';
		form?.querySelectorAll<HTMLInputElement>('[data-attribution]').forEach((input) => {
			input.value = attribution[input.dataset.attribution ?? ''] ?? '';
		});
	} catch {
		// Attribution is best effort.
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const buttonText = form.querySelector<HTMLElement>('[data-submit-text]');
		const formError = form.querySelector<HTMLElement>('[data-form-error]');
		const submitLabel = form.dataset.submitLabel ?? '';
		const submittingLabel = form.dataset.submittingLabel ?? '';

		form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((error) => {
			error.textContent = '';
			error.classList.add('hidden');
		});
		form.querySelectorAll<HTMLElement>('[aria-invalid]').forEach((field) => {
			field.removeAttribute('aria-invalid');
			field.closest<HTMLElement>('[data-slot="field"]')?.removeAttribute('data-invalid');
		});
		formError?.classList.add('hidden');
		if (button) button.disabled = true;
		if (buttonText) buttonText.textContent = submittingLabel;

		try {
			const response = await fetch(form.action, {
				method: 'POST',
				headers: { accept: 'application/json' },
				body: new FormData(form)
			});
			const result = (await response.json()) as ContactResponse;

			if (response.ok && result.success) {
				form.reset();
				const dataLayer = ((window as unknown as { dataLayer?: object[] }).dataLayer ??= []);
				dataLayer.push({
					event:
						form.querySelector<HTMLInputElement>('[name="mode"]')?.value === 'book'
							? 'booking_submit'
							: 'contact_submit',
					page: location.pathname
				});
				form.classList.add('hidden');
				success?.classList.remove('hidden');
				success?.classList.add('flex');
				success?.focus();
				return;
			}

			Object.entries(result.errors ?? {}).forEach(([fieldName, messages]) => {
				const field = form.elements.namedItem(fieldName);
				const fieldControl = form.querySelector<HTMLElement>(`[data-field-control="${fieldName}"]`);
				const error = form.querySelector<HTMLElement>(`[data-error-for="${fieldName}"]`);
				const invalidControl = fieldControl ?? (field instanceof HTMLElement ? field : null);
				if (invalidControl) {
					invalidControl.setAttribute('aria-invalid', 'true');
					invalidControl
						.closest<HTMLElement>('[data-slot="field"]')
						?.setAttribute('data-invalid', 'true');
				}
				if (error) {
					error.textContent = messages[0] ?? '';
					error.classList.remove('hidden');
				}
			});
			if (result.unavailable || !result.errors) formError?.classList.remove('hidden');
		} catch {
			formError?.classList.remove('hidden');
		} finally {
			if (button) button.disabled = false;
			if (buttonText) buttonText.textContent = submitLabel;
		}
	});
</script>
