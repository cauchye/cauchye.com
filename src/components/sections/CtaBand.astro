				vector-effect="non-scaling-stroke"
				style="--curve-index: 0"></path>
			<path
				d="M0 297.6 L12 297.5 L24 297.4 L36 297.4 L48 297.3 L60 297.2 L72 297.1 L84 297.0 L96 296.9 L108 296.8 L120 296.7 L132 296.5 L144 296.4 L156 296.3 L168 296.1 L180 296.0 L192 295.8 L204 295.6 L216 295.4 L228 295.2 L240 295.0 L252 294.8 L264 294.6 L276 294.3 L288 294.1 L300 293.8 L312 293.4 L324 293.1 L336 292.7 L348 292.3 L360 291.9 L372 291.5 L384 291.0 L396 290.4 L408 289.8 L420 289.2 L432 288.4 L444 287.6 L456 286.8 L468 285.8 L480 284.7 L492 283.5 L504 282.2 L516 280.7 L528 279.0 L540 277.1 L552 274.9 L564 272.4 L576 269.6 L588 266.3 L600 262.4 L612 258.0 L624 252.8 L636 246.7 L648 239.5 L660 230.9 L672 220.8 L684 208.9 L696 195.0 L708 178.9 L720 160.9 L732 141.7 L744 122.6 L756 105.8 L768 94.2 L780 90.0 L792 94.2 L804 105.8 L816 122.6 L828 141.7 L840 160.9 L852 178.9 L864 195.0 L876 208.9 L888 220.8 L900 230.9 L912 239.5 L924 246.7 L936 252.8 L948 258.0 L960 262.4 L972 266.3 L984 269.6 L996 272.4 L1008 274.9 L1020 277.1 L1032 279.0 L1044 280.7 L1056 282.2 L1068 283.5 L1080 284.7 L1092 285.8 L1104 286.8 L1116 287.6 L1128 288.4 L1140 289.2 L1152 289.8 L1164 290.4 L1176 291.0 L1188 291.5 L1200 291.9"
