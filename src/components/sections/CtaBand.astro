---
import { ArrowRight, CalendarDays } from 'lucide-astro';

import type { Dictionary, Locale } from '../../i18n';
import { consultHref } from '../../site';
import { Button } from '../ui/button/index.js';

interface Props {
	locale: Locale;
	messages: Dictionary;
	placement?: string;
}

const { locale, messages: m, placement = 'band' } = Astro.props;
---

<section class="pb-20 md:pb-28" data-cta-band>
	<div
		class="relative overflow-clip rounded-3xl bg-brand px-6 py-16 text-brand-foreground md:px-14 md:py-20"
		data-reveal="scale"
	>
		<div
			class="pointer-events-none absolute -top-20 -right-16 size-80 rounded-full bg-white/15 blur-3xl"
			data-glow
			aria-hidden="true"
		>
		</div>
		<div
			class="pointer-events-none absolute -bottom-24 -left-20 size-96 rounded-full bg-cyan-300/25 blur-3xl"
			data-glow
			style="animation-delay: -6s"
			aria-hidden="true"
		>
		</div>
		<!-- Density curves of Cauchy distributions, drawn as the band scrolls in. -->
		<svg
			class="pointer-events-none absolute inset-x-0 bottom-0 h-full w-full text-white/25"
			viewBox="0 0 1200 300"
			preserveAspectRatio="none"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			vector-effect="non-scaling-stroke"
			data-band-curves
			aria-hidden="true"
		>
