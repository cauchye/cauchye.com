				vector-effect="non-scaling-stroke"
				style="--curve-index: 2"></path>
			<path
				d="M0 267.1 L12 266.3 L24 265.4 L36 264.4 L48 263.5 L60 262.4 L72 261.4 L84 260.3 L96 259.2 L108 258.0 L120 256.8 L132 255.5 L144 254.2 L156 252.8 L168 251.4 L180 249.9 L192 248.3 L204 246.7 L216 245.0 L228 243.2 L240 241.4 L252 239.5 L264 237.5 L276 235.4 L288 233.2 L300 230.9 L312 228.6 L324 226.1 L336 223.5 L348 220.8 L360 218.0 L372 215.1 L384 212.1 L396 208.9 L408 205.7 L420 202.2 L432 198.7 L444 195.0 L456 191.2 L468 187.2 L480 183.2 L492 178.9 L504 174.6 L516 170.2 L528 165.6 L540 160.9 L552 156.2 L564 151.4 L576 146.6 L588 141.7 L600 136.8 L612 132.0 L624 127.2 L636 122.6 L648 118.1 L660 113.8 L672 109.7 L684 105.8 L696 102.4 L708 99.2 L720 96.5 L732 94.2 L744 92.4 L756 91.1 L768 90.3 L780 90.0 L792 90.3 L804 91.1 L816 92.4 L828 94.2 L840 96.5 L852 99.2 L864 102.4 L876 105.8 L888 109.7 L900 113.8 L912 118.1 L924 122.6 L936 127.2 L948 132.0 L960 136.8 L972 141.7 L984 146.6 L996 151.4 L1008 156.2 L1020 160.9 L1032 165.6 L1044 170.2 L1056 174.6 L1068 178.9 L1080 183.2 L1092 187.2 L1104 191.2 L1116 195.0 L1128 198.7 L1140 202.2 L1152 205.7 L1164 208.9 L1176 212.1 L1188 215.1 L1200 218.0"
				pathLength="1"
				vector-effect="non-scaling-stroke"
				style="--curve-index: 3"></path>
		</svg>
		<div class="relative grid items-center gap-8 md:grid-cols-[1fr_auto]">
			<div>
				<h2 class="text-3xl font-semibold md:text-5xl">{m.band_title}</h2>
				<p class="mt-4 max-w-2xl text-white/75 md:text-lg">{m.band_body}</p>
			</div>
			<div class="flex flex-col gap-3">
				<Button
					href={consultHref(locale)}
					variant="secondary"
					size="lg"
					class="h-12 px-6"
					data-cta={`${placement}-consult`}
				>
					<CalendarDays data-icon="inline-start" />
					{m.cta_consult}
					<ArrowRight data-icon="inline-end" />
				</Button>
				<a
					href={`/${locale}/contact`}
					class="text-center text-sm text-white/80 underline-offset-4 hover:underline"
					data-cta={`${placement}-contact`}
				>
					{m.cta_contact_other}
				</a>
			</div>
		</div>
	</div>
</section>
