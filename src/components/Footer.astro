---
import { ExternalLink, Mail } from 'lucide-astro';

import { Separator } from './ui/separator/index.js';
import type { Dictionary, Locale } from '../i18n';
import { addressLines, d6e, d6eUrl, navItems, officialAccounts, site } from '../site';

interface Props {
	locale: Locale;
	messages: Dictionary;
	showArticles?: boolean;
}

const { locale, messages: m, showArticles = false } = Astro.props;
const home = `/${locale}`;
const year = new Date().getFullYear();
// d6e is ours: the footer of every page links it, and says whose product it is.
const productLinks = [
	{ id: 'd6e-bots', label: 'D6E Bots', href: d6eUrl(locale, '/bots') },
	{ id: 'd6e', label: 'D6E', href: d6eUrl(locale) },
	{ id: 'd6e-gateway', label: 'D6E AI Gateway', href: d6e.gatewayUrl }
];
---

<footer class="mt-auto border-t border-border bg-muted/30">
	<div class="container mx-auto py-14">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr_1fr]">
			<div>
				<div class="flex items-center gap-2.5">
					<img src="/favicon.svg" alt="" class="size-6" width="24" height="24" loading="lazy" />
					<span class="text-sm font-semibold tracking-widest">{site.legalName}</span>
				</div>
				<a
					href={`${home}/contact`}
					class="mt-5 inline-flex items-center gap-2 text-sm text-foreground underline-offset-4 transition-colors hover:text-brand hover:underline"
				>
					<Mail class="size-4" />
					{m.nav_contact}
				</a>
			</div>

			<nav aria-label={m.footer_nav_label}>
				<h2 class="font-mono text-[0.6875rem] tracking-[0.14em] text-muted-foreground uppercase">
					{m.footer_nav_label}
				</h2>
				<ul class="mt-4 flex flex-col gap-2.5">
					{
						navItems.map((item) => (
							<li>
								<a
									href={`${home}${item.path}`}
									class="text-sm text-muted-foreground transition-colors hover:text-foreground"
								>
									{m[item.label]}
								</a>
							</li>
						))
					}
					{
						showArticles && (
							<li>
								<a
									href={`${home}/articles`}
									class="text-sm text-muted-foreground transition-colors hover:text-foreground"
								>
									{m.nav_articles}
								</a>
							</li>
						)
					}
				</ul>
			</nav>

			<div data-footer-products>
				<h2 class="font-mono text-[0.6875rem] tracking-[0.14em] text-muted-foreground uppercase">
					{m.footer_products_label}
				</h2>
				<ul class="mt-4 flex flex-col gap-2.5">
					{
						productLinks.map((product) => (
							<li>
								<a
									href={product.href}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
								>
									{product.label}
									<ExternalLink class="size-3.5" aria-hidden="true" />
								</a>
							</li>
						))
					}
				</ul>
				<p class="mt-4 max-w-60 text-xs leading-relaxed text-balance text-muted-foreground">
					{m.footer_products_note}
				</p>
			</div>

			<div data-official-accounts>
				<h2 class="font-mono text-[0.6875rem] tracking-[0.14em] text-muted-foreground uppercase">
					{m.footer_official_label}
				</h2>
				<ul class="mt-4 flex flex-col gap-2.5">
					{
						officialAccounts.map((media) => (
							<li>
								<a
									href={media.url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
								>
									{media.label}
									<ExternalLink class="size-3.5" aria-hidden="true" />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="font-mono text-[0.6875rem] tracking-[0.14em] text-muted-foreground uppercase">
					{m.footer_company_label}
				</h2>
				<address class="mt-4 text-sm leading-relaxed text-muted-foreground not-italic">
					<span class="block text-foreground">{site.legalName}</span>
					{addressLines.map((line) => <span class="block">{line}</span>)}
				</address>
			</div>
		</div>
		<Separator class="my-10" />
		<p class="text-xs text-muted-foreground">© {year} {site.legalName} {m.footer_rights}</p>
	</div>
</footer>
