---
import { ArrowRight } from 'lucide-astro';

import { type ArticleSummary, formatArticleDate } from '../../cms/articles';
import type { Locale } from '../../i18n';

interface Props {
	locale: Locale;
	article: ArticleSummary;
	readLabel: string;
	// Level of the title heading: 3 when the card sits under a section heading.
	headingLevel?: 2 | 3;
}

const { locale, article, readLabel, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<a
	href={`/${locale}/articles/${article.slug}`}
	data-article-card
	class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card text-card-foreground shadow-sm transition-all hover:-translate-y-1 hover:border-brand/30 hover:shadow-lg"
>
	{
		article.image && (
			<div class="aspect-video overflow-hidden border-b border-border bg-muted">
				<img
					src={article.image.src}
					alt={article.image.alt}
					width={article.image.width}
					height={article.image.height}
					loading="lazy"
					decoding="async"
					class="size-full object-cover"
				/>
			</div>
		)
	}
	<div class="flex flex-1 flex-col p-6">
		{
			article.publishedAt && (
				<time
					datetime={article.publishedAt.toISOString()}
					class="font-mono text-[0.6875rem] tracking-[0.14em] text-muted-foreground uppercase"
				>
					{formatArticleDate(article.publishedAt, locale)}
				</time>
			)
		}
		<Heading class="mt-3 text-xl leading-snug font-semibold text-wrap md:text-2xl">
			{article.title}
		</Heading>
		{
			article.excerpt && (
				<p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted-foreground">
					{article.excerpt}
				</p>
			)
		}
		<span class="mt-auto flex items-center gap-1.5 pt-6 text-sm font-medium text-brand">
			{readLabel}
			<ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
		</span>
	</div>
</a>
