---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.svelte';
import { hasArticles } from '../cms/content';
import type { Dictionary, Locale } from '../i18n';
import { site } from '../site';
import '../styles/global.css';

interface Props {
	locale: Locale;
	messages: Dictionary;
	pageTitle?: string;
	description?: string;
	pagePath?: string;
	// Path of this page in the other locale, when it differs from `pagePath`.
	translationPath?: string;
}

const {
	locale,
	messages,
	pageTitle,
	description = messages.hero_body,
	pagePath = '',
	translationPath = pagePath
} = Astro.props;
const title = pageTitle
	? `${pageTitle} | ${site.shortName}`
	: `${site.legalName} — ${messages.brand_descriptor}`;
const localizedPath = `/${locale}${pagePath}`;
const pageUrl = `${site.url}${localizedPath}`;
const alternateUrl = (alternate: Locale) =>
	`${site.url}/${alternate}${alternate === locale ? pagePath : translationPath}`;
// The article list is only linked once it has something to show.
const showArticles = await hasArticles(Astro, locale);
const organizationSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: site.legalName,
	alternateName: site.shortName,
	url: site.url,
	description,
	identifier: site.uen,
	foundingDate: String(site.foundedYear),
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${site.address.street}, ${site.address.unit}`,
		addressLocality: site.address.locality,
		postalCode: site.address.postalCode,
		addressCountry: site.address.country
	}
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={pageUrl} />
		<link rel="alternate" hreflang="en" href={alternateUrl('en')} />
		<link rel="alternate" hreflang="ja" href={alternateUrl('ja')} />
		<link rel="alternate" hreflang="x-default" href={alternateUrl('en')} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<script is:inline type="application/ld+json" set:html={organizationSchema} />
	</head>
	<body>
		<div class="flex min-h-svh flex-col">
			<Header {locale} messages={messages} {pagePath} {translationPath} client:load />
			<main class="container mx-auto flex-1">
				<slot />
			</main>
			<Footer {locale} messages={messages} {showArticles} />
		</div>
	</body>
</html>
