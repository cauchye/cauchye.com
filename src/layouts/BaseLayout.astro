---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.svelte';
import { hasArticles } from '../cms/content';
import { type Dictionary, type Locale, locales } from '../i18n';
import { feedPath } from '../cms/rss';
import { absoluteUrl, analytics, defaultShareImage, officialAccounts, site } from '../site';
import '../styles/global.css';

interface Props {
	locale: Locale;
	messages: Dictionary;
	pageTitle?: string;
	description?: string;
	pagePath?: string;
	// Path of this page in the other locale, when it differs from `pagePath`.
	translationPath?: string;
	// False when the other locale has no version of this page: it is then not an alternate.
	hasTranslation?: boolean;
	ogType?: 'website' | 'article';
	// Share image, as a site path or an absolute URL. The site's default image when omitted.
	ogImage?: string;
	ogImageAlt?: string;
	publishedTime?: Date;
	// Keeps the page out of search results (campaign landing pages).
	noindex?: boolean;
}

const {
	locale,
	messages,
	pageTitle,
	description = messages.hero_body,
	pagePath = '',
	translationPath = pagePath,
	hasTranslation = true,
	ogType = 'website',
	ogImage,
	ogImageAlt,
	publishedTime,
	noindex = false
} = Astro.props;
const title = pageTitle
	? `${pageTitle} | ${site.shortName}`
	: `${site.legalName} — ${messages.brand_descriptor}`;
const localizedPath = `/${locale}${pagePath}`;
const pageUrl = `${site.url}${localizedPath}`;
const alternateUrl = (alternate: Locale) =>
	`${site.url}/${alternate}${alternate === locale ? pagePath : translationPath}`;
// As in the sitemap: English is the default, unless this page has no English version.
const alternateLocales = hasTranslation ? locales : [locale];
const defaultLocale = alternateLocales.includes('en') ? 'en' : locale;
const OG_LOCALES: Record<Locale, string> = { en: 'en_US', ja: 'ja_JP' };
// Crawlers need an absolute image URL; a page without its own image shares the default one.
const imageUrl = absoluteUrl(ogImage ?? defaultShareImage.path);
const imageAlt = ogImage ? ogImageAlt : defaultShareImage.alt;
// The article list is only linked once it has something to show.
const showArticles = await hasArticles(Astro, locale);
const organizationSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: site.legalName,
	alternateName: site.shortName,
	url: site.url,
	description,
	identifier: site.uen,
	foundingDate: String(site.foundedYear),
	sameAs: officialAccounts.map((account) => account.url),
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${site.address.street}, ${site.address.unit}`,
		addressLocality: site.address.locality,
		postalCode: site.address.postalCode,
		addressCountry: site.address.country
	}
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={pageUrl} />
		{
			alternateLocales.map((alternate) => (
				<link rel="alternate" hreflang={alternate} href={alternateUrl(alternate)} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={alternateUrl(defaultLocale)} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${site.shortName} — ${messages.articles_title}`}
			href={absoluteUrl(feedPath(locale))}
		/>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content={site.legalName} />
		<meta property="og:locale" content={OG_LOCALES[locale]} />
		<meta property="og:image" content={imageUrl} />
		{
			!ogImage && (
				<>
					<meta property="og:image:width" content={String(defaultShareImage.width)} />
					<meta property="og:image:height" content={String(defaultShareImage.height)} />
				</>
			)
		}
		{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
		{
			ogType === 'article' && publishedTime && (
				<meta property="article:published_time" content={publishedTime.toISOString()} />
			)
		}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
		<script is:inline type="application/ld+json" set:html={organizationSchema} />
		{
			analytics.cloudflareBeaconToken && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={JSON.stringify({ token: analytics.cloudflareBeaconToken })}
				/>
			)
		}
		<script is:inline>
			// Lead attribution: remember the first page of the visit (UTM, referrer, landing
			// path) and the last CTA clicked, so the contact form can send them. Clicks are also
			// pushed to `dataLayer` for an analytics tool that reads it.
			(function () {
				try {
					const key = 'cauchye_attribution';
					if (!sessionStorage.getItem(key)) {
						const params = new URLSearchParams(location.search);
						const first = { landing: location.pathname };
						['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(
							function (name) {
								const value = params.get(name);
								if (value) first[name] = value;
							}
						);
						const referrer = document.referrer;
						if (referrer && new URL(referrer).host !== location.host) first.referrer = referrer;
						sessionStorage.setItem(key, JSON.stringify(first));
					}
					window.dataLayer = window.dataLayer || [];
					document.addEventListener('click', function (event) {
						const target =
							event.target instanceof Element ? event.target.closest('[data-cta]') : null;
						if (!target) return;
						const cta = target.getAttribute('data-cta');
						sessionStorage.setItem('cauchye_cta', cta);
						window.dataLayer.push({ event: 'cta_click', cta: cta, page: location.pathname });
					});
				} catch {
					// Storage can be unavailable (private mode); attribution is best effort.
				}
			})();
		</script>
	</head>
	<body>
		<div class="flex min-h-svh flex-col">
			<Header
				{locale}
				messages={messages}
				{pagePath}
				{translationPath}
				{showArticles}
				client:load
			/>
			<main class="container mx-auto flex-1">
				<slot />
			</main>
			<Footer {locale} messages={messages} {showArticles} />
		</div>
	</body>
</html>
