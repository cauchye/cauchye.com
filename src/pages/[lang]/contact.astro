---
import Contact from '../../components/sections/Contact.astro';
import { getDictionary, isLocale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/en/contact', 302);
const messages = getDictionary(lang);
const contactState =
	Astro.url.searchParams.get('contact') === 'success'
		? 'success'
		: Astro.url.searchParams.get('contact') === 'error'
			? 'error'
			: undefined;
---

<BaseLayout
	locale={lang}
	{messages}
	pageTitle={messages.contact_title}
	description={messages.contact_body}
	pagePath="/contact"
>
	<Contact locale={lang} {messages} state={contactState} />
</BaseLayout>
