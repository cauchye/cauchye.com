---
import { ArrowRight, Bot, Check, ChevronRight, CodeXml, ExternalLink, Gauge } from 'lucide-astro';

import ArticleTeasers from '../../../components/sections/ArticleTeasers.astro';
import PartnerShowcase from '../../../components/sections/PartnerShowcase.astro';
import SectionHeading from '../../../components/sections/SectionHeading.astro';
import { Badge } from '../../../components/ui/badge/index.js';
import { Button } from '../../../components/ui/button/index.js';
import {
	Card,
	CardContent,
	CardDescription,
	CardFooter,
	CardHeader,
	CardTitle
} from '../../../components/ui/card/index.js';
import { getMessages, getPartners } from '../../../cms/content';
import { isLocale } from '../../../i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { d6e } from '../../../site';

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/en/business/it-ai', 302);
const m = await getMessages(Astro, lang);
const contactHref = `/${lang}/contact`;

const offerings = [
	{
		icon: Bot,
		title: m.ai_offering_agent_title,
		body: m.ai_offering_agent_body,
		note: m.ai_offering_agent_note,
		points: [m.ai_offering_agent_point_1, m.ai_offering_agent_point_2, m.ai_offering_agent_point_3],
		href: `/${lang}/business/it-ai/agent-adoption`,
		cta: m.ai_offering_agent_cta,
		external: false,
		product: false
	},
	{
		icon: CodeXml,
		title: m.ai_offering_development_title,
		body: m.ai_offering_development_body,
		note: m.ai_offering_development_note,
		points: [
			m.ai_offering_development_point_1,
			m.ai_offering_development_point_2,
			m.ai_offering_development_point_3
		],
		href: `/${lang}/business/it-ai/solution-development`,
		cta: m.ai_offering_development_cta,
		external: false,
		product: false
	},
	{
		icon: Gauge,
		title: 'd6e AI Gateway',
		body: m.gateway_body,
		note: m.ai_offering_gateway_note,
		points: [m.gateway_point_1, m.gateway_point_2, m.gateway_point_3],
		href: d6e.gatewayUrl,
		cta: m.gateway_cta,
		external: true,
		product: true
	}
];

const partners = await getPartners(Astro, lang, 'it-ai');
---

<BaseLayout
	locale={lang}
	messages={m}
	pageTitle={m.ai_meta_title}
	description={m.ai_meta_description}
	pagePath="/business/it-ai"
>
	<section class="relative isolate py-16 md:py-24">
		<div
			class="pointer-events-none absolute inset-0 -z-10 -mx-5 grid-backdrop md:-mx-8"
			aria-hidden="true"
		>
		</div>
		<nav aria-label={m.breadcrumb_label}>
			<ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
				<li>
					<a href={`/${lang}`} class="transition-colors hover:text-foreground"
						>{m.breadcrumb_home}</a
					>
				</li>
				<li aria-hidden="true"><ChevronRight class="size-4" /></li>
				<li>
					<a href={`/${lang}/#services`} class="transition-colors hover:text-foreground"
						>{m.nav_services}</a
					>
				</li>
				<li aria-hidden="true"><ChevronRight class="size-4" /></li>
				<li class="text-foreground" aria-current="page">{m.business_ai_title}</li>
			</ol>
		</nav>
		<div class="mt-10 grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-end">
			<div>
				<Badge
					variant="outline"
					class="rounded-full px-3 py-1 font-mono text-[0.65rem] tracking-[0.16em] uppercase"
					>{m.ai_eyebrow}</Badge
				>
				<h1 class="mt-6 text-4xl leading-[1.08] font-semibold sm:text-5xl md:text-7xl">
					<span class="block">{m.ai_hero_title_lead}</span>
					<span class="block text-brand">{m.ai_hero_title_accent}</span>
				</h1>
				<p class="mt-7 text-base leading-relaxed text-muted-foreground md:text-xl">
					{m.ai_hero_body}
				</p>
				<div class="mt-9 flex flex-wrap gap-3">
					<Button href={contactHref} variant="brand" size="lg" class="h-11 px-5">
						{m.ai_cta_primary}<ArrowRight data-icon="inline-end" />
					</Button>
					<Button href="#capabilities" variant="outline" size="lg" class="h-11 px-5"
						>{m.ai_cta_secondary}</Button
					>
				</div>
			</div>
			<div
				class="hidden justify-self-end rounded-3xl border border-brand/20 bg-brand-subtle p-8 text-brand lg:block"
			>
				<Bot class="size-36" stroke-width={1.15} />
			</div>
		</div>
	</section>

	<PartnerShowcase eyebrow={m.ai_partners_eyebrow} title={m.ai_partners_title} {partners} />

	<section id="capabilities" class="border-t border-border section">
		<SectionHeading eyebrow={m.ai_offerings_eyebrow} title={m.ai_offerings_title} />
		<div class="mt-12 grid items-stretch gap-5 lg:grid-cols-3">
			{
				offerings.map(({ icon: Icon, title, body, note, points, href, cta, external, product }) => (
					<Card
						class:list={[
							'h-full overflow-hidden transition-all hover:-translate-y-1 hover:shadow-lg',
							product ? 'border-brand/25 bg-brand-subtle' : 'hover:border-brand/30'
						]}
					>
						<CardHeader>
							<div class="flex items-start justify-between gap-4">
								<span class="flex size-11 items-center justify-center rounded-xl bg-brand-subtle text-brand">
									<Icon class="size-5" />
								</span>
								<Badge variant="outline" class="rounded-full text-[0.6875rem]">
									{note}
								</Badge>
							</div>
							<CardTitle class="mt-5">
								<h3 class="text-xl leading-tight font-semibold md:text-2xl">{title}</h3>
							</CardTitle>
							<CardDescription class="text-base leading-relaxed">{body}</CardDescription>
						</CardHeader>
						<CardContent class="flex-auto">
							<ul class="grid gap-3">
								{points.map((point) => (
									<li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
										<Check class="mt-0.5 size-4 shrink-0 text-brand" />
										<span>{point}</span>
									</li>
								))}
							</ul>
						</CardContent>
						<CardFooter>
							<Button
								href={href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noreferrer' : undefined}
								variant={product ? 'brand' : 'outline'}
								class="w-full"
							>
								{cta}
								{external ? (
									<ExternalLink data-icon="inline-end" />
								) : (
									<ArrowRight data-icon="inline-end" />
								)}
							</Button>
						</CardFooter>
					</Card>
				))
			}
		</div>
	</section>

	<ArticleTeasers locale={lang} messages={m} title={m.articles_related_title} />

	<section class="pb-20 md:pb-28">
		<div
			class="relative overflow-hidden rounded-3xl bg-brand px-6 py-14 text-brand-foreground md:px-12 md:py-18"
		>
			<div class="relative">
				<h2 class="text-3xl font-semibold md:text-5xl">{m.ai_overview_cta_title}</h2>
				<p class="mt-4 text-white/70 md:text-lg">{m.ai_overview_cta_body}</p>
				<Button href={contactHref} variant="secondary" size="lg" class="mt-8 h-11 px-5">
					{m.ai_cta_primary}<ArrowRight data-icon="inline-end" />
				</Button>
			</div>
		</div>
	</section>
</BaseLayout>
