---
import {
	ArrowRight,
	BarChart3,
	Check,
	CircleDollarSign,
	ChevronRight,
	Globe2,
	Landmark,
	MessagesSquare,
	SearchCheck,
	Sparkles
} from 'lucide-astro';

import PartnerShowcase from '../../../components/sections/PartnerShowcase.astro';
import SectionHeading from '../../../components/sections/SectionHeading.astro';
import { Badge } from '../../../components/ui/badge/index.js';
import { Button } from '../../../components/ui/button/index.js';
import { Card, CardContent, CardHeader } from '../../../components/ui/card/index.js';
import { getDictionary, isLocale } from '../../../i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.redirect('/en/business/corporate-advisory', 302);
const m = getDictionary(lang);
const contactHref = `/${lang}/contact`;
const services = [
	{
		icon: MessagesSquare,
		title: m.advisory_service_1_title,
		body: m.advisory_service_1_body
	},
	{
		icon: CircleDollarSign,
		title: m.advisory_service_2_title,
		body: m.advisory_service_2_body
	},
	{
		icon: SearchCheck,
		title: m.advisory_service_3_title,
		body: m.advisory_service_3_body
	}
];
const strengths = [
	m.advisory_strength_point_1,
	m.advisory_strength_point_2,
	m.advisory_strength_point_3,
	m.advisory_strength_point_4
];
const partners = [
	{
		name: lang === 'ja' ? 'テセウスコンサルティング株式会社' : 'Theseus Consulting Inc.',
		logo: '/partners/theseus-consulting.png',
		site: 'https://theseus-grp.com/',
		logoClass: 'h-16 w-full'
	}
];
---

<BaseLayout
	locale={lang}
	messages={m}
	pageTitle={m.advisory_meta_title}
	description={m.advisory_meta_description}
	pagePath="/business/corporate-advisory"
>
	<section class="relative isolate py-16 md:py-24">
		<div
			class="pointer-events-none absolute inset-0 -z-10 -mx-5 grid-backdrop md:-mx-8"
			aria-hidden="true"
		>
		</div>
		<nav aria-label={m.breadcrumb_label}>
			<ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
				<li>
					<a href={`/${lang}`} class="transition-colors hover:text-foreground"
						>{m.breadcrumb_home}</a
					>
				</li>
				<li aria-hidden="true"><ChevronRight class="size-4" /></li>
				<li>
					<a href={`/${lang}/#services`} class="transition-colors hover:text-foreground"
						>{m.nav_services}</a
					>
				</li>
				<li aria-hidden="true"><ChevronRight class="size-4" /></li>
				<li class="text-foreground" aria-current="page">{m.business_advisory_title}</li>
			</ol>
		</nav>
		<div class="mt-10 grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-end">
			<div>
				<Badge
					variant="outline"
					class="rounded-full px-3 py-1 font-mono text-[0.65rem] tracking-[0.16em] uppercase"
					>{m.advisory_eyebrow}</Badge
				>
				<h1 class="mt-6 text-4xl leading-[1.08] font-semibold sm:text-5xl md:text-7xl">
					<span class="block">{m.advisory_hero_title_lead}</span>
					<span class="block text-brand">{m.advisory_hero_title_accent}</span>
				</h1>
				<p class="mt-7 text-base leading-relaxed text-muted-foreground md:text-xl">
					{m.advisory_hero_body}
				</p>
				<div class="mt-9 flex flex-wrap items-center gap-3">
					<Button href={contactHref} variant="brand" size="lg" class="h-11 px-5"
						>{m.advisory_cta_primary}<ArrowRight data-icon="inline-end" /></Button
					>
					<Badge variant="secondary" class="h-8 rounded-full px-3">{m.advisory_scope_label}</Badge>
				</div>
			</div>
			<div
				class="relative hidden justify-self-end rounded-3xl border border-brand/20 bg-brand-subtle p-8 text-brand lg:block"
			>
				<Landmark class="size-36" stroke-width={1.15} />
				<BarChart3
					class="absolute right-5 bottom-5 size-16 rounded-xl bg-background/90 p-3 shadow-lg"
				/>
			</div>
		</div>
	</section>

	<section id="capabilities" class="border-t border-border section">
		<SectionHeading eyebrow={m.advisory_services_eyebrow} title={m.advisory_services_title} />
		<div class="mt-12 grid gap-5 lg:grid-cols-3">
			{
				services.map(({ icon: Icon, title, body }) => (
					<Card class="group min-h-[22rem] transition-all hover:-translate-y-1 hover:border-brand/30 hover:shadow-lg">
						<CardHeader>
							<div class="flex items-center">
								<span class="flex size-11 items-center justify-center rounded-xl bg-brand-subtle text-brand">
									<Icon class="size-5" />
								</span>
							</div>
							<h2 class="mt-5 text-xl font-semibold md:text-2xl">{title}</h2>
						</CardHeader>
						<CardContent>
							<p class="leading-relaxed text-muted-foreground">{body}</p>
						</CardContent>
					</Card>
				))
			}
		</div>
	</section>

	<section id="perspective" class="border-t border-border section">
		<div class="relative overflow-hidden rounded-3xl bg-muted/55 p-6 md:p-12">
			<Globe2 class="absolute -right-12 -bottom-16 size-80 text-brand/8" stroke-width={1} />
			<div class="relative grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
				<div>
					<p class="font-mono text-[0.6875rem] tracking-[0.14em] text-brand uppercase">
						{m.advisory_strength_eyebrow}
					</p>
					<h2 class="mt-3 text-3xl font-semibold md:text-5xl">{m.advisory_strength_title}</h2>
					<p class="mt-5 leading-relaxed text-muted-foreground">{m.advisory_strength_body}</p>
				</div>
				<div class="grid gap-3 sm:grid-cols-2">
					{
						strengths.map((strength) => (
							<div class="flex gap-3 rounded-xl border border-border bg-background/85 p-5 shadow-sm">
								<span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-subtle text-brand">
									<Check class="size-3.5" />
								</span>
								<p class="text-sm leading-relaxed">{strength}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<PartnerShowcase
		eyebrow={m.advisory_partners_eyebrow}
		title={m.advisory_partners_title}
		{partners}
	/>

	<section class="pb-20 md:pb-28">
		<div
			class="dark relative overflow-hidden rounded-3xl bg-background px-6 py-14 text-foreground md:px-12 md:py-18"
		>
			<Sparkles class="absolute -top-8 -right-6 size-48 text-brand/15" />
			<div class="relative">
				<h2 class="text-3xl font-semibold md:text-5xl">{m.advisory_cta_title}</h2>
				<p class="mt-4 text-muted-foreground md:text-lg">{m.advisory_cta_body}</p>
				<Button
					href={contactHref}
					variant="brand"
					size="lg"
					class="mt-8 h-auto min-h-11 w-full px-5 text-center whitespace-normal sm:w-auto"
					>{m.advisory_cta_primary}<ArrowRight data-icon="inline-end" /></Button
				>
			</div>
		</div>
	</section>
</BaseLayout>
