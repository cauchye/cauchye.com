---
import ArticleTeasers from '../../components/sections/ArticleTeasers.astro';
import Company from '../../components/sections/Company.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Flow from '../../components/sections/Flow.astro';
import Hero from '../../components/sections/Hero.astro';
import OfficialMedia from '../../components/sections/OfficialMedia.astro';
import Services from '../../components/sections/Services.astro';
import { getMessages } from '../../cms/content';
import { isLocale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang } = Astro.params;
if (!isLocale(lang)) {
	return Astro.redirect('/en', 302);
}
const messages = await getMessages(Astro, lang);
---

<BaseLayout locale={lang} {messages}>
	<Hero locale={lang} {messages} />
	<Services locale={lang} {messages} />
	<Flow {messages} />
	<Company {messages} />
	<OfficialMedia {messages} />
	<ArticleTeasers locale={lang} {messages} title={messages.articles_latest_title} />
	<CtaBand locale={lang} {messages} placement="home-band" />
</BaseLayout>
