{
	"name": "cauchye.com",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.23.0",
	"emdash": {
		"label": "CAUCHYE ASIA PTE. LTD.",
		"seed": "seed/seed.json"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "pnpm run check",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"types": "wrangler types",
		"articles:import": "node scripts/import-articles.ts",
		"articles:fixtures": "node scripts/seed-article-fixtures.ts",
		"articles:add": "node scripts/add-article.ts",
		"og:build": "node scripts/build-og-image.ts",
		"seed:build": "node scripts/build-seed.ts && prettier --write seed/seed.json",
		"deploy": "pnpm run build && wrangler deploy",
		"deploy:dry-run": "pnpm run build && wrangler deploy --dry-run"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.2.3",
		"@astrojs/react": "^6.0.6",
		"@astrojs/svelte": "^9.0.1",
		"@emdash-cms/cloudflare": "^0.36.0",
		"@fontsource-variable/inter": "5.3.0",
		"@lucide/svelte": "^1.34.0",
		"astro": "7.2.4",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"emdash": "^0.36.0",
		"lucide-astro": "0.556.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"svelte": "^5.56.10",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "24.13.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "3.1.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.5.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^5.0.3",
		"wrangler": "4.127.0"
	}
}
