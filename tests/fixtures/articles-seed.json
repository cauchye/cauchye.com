							"_type": "block",
							"style": "blockquote",
							"children": [
								{
									"_type": "span",
									"text": "引用の表示例です。"
								}
							]
						},
						{
							"_type": "image",
							"asset": {
								"url": "/agents/codex-interface.webp"
							},
							"alt": "本文画像のサンプル",
							"caption": "本文中の画像とキャプションの表示例"
