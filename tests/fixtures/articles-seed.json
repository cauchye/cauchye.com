						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "二つ目の項目"
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "三つ目の項目"
								}
							],
							"listItem": "bullet",
							"level": 1
						},
