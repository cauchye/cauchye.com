{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"resolveJsonModule": true,
		"types": ["./worker-configuration.d.ts"]
	},
	"include": [
		".astro/types.d.ts",
		"src/**/*",
		"scripts/**/*",
		"tests/unit/**/*",
		"emdash-env.d.ts",
		"worker-configuration.d.ts"
	]
}
